# LLM Providers
GROQ_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=key1,key2

# Vector Store
MONGODB_URI=                           # Atlas URI pointing to MongoDB
VECTOR_STORE=mongodb                   # Using MongoDB as primary

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.72
RETRIEVAL_MODE=hybrid                  # options: dense | sparse | hybrid

# Cache
REDIS_URL=redis://localhost:6379/0

# App
LOG_LEVEL=INFO
ENVIRONMENT=development                # options: development | production